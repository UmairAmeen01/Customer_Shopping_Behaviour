      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0h4cowi089yele12bd8c2103viyp].[sum:Calculation_1077517617221632:qk]&quot;' value='Customers' />
          <alias key='&quot;[federated.0h4cowi089yele12bd8c2103viyp].[sum:purchase_amount:qk]&quot;' value='Revenue (USD)' />
        </aliases>
      </column>
      <column caption='Purchase count' datatype='integer' name='[Calculation_1077517617221632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ &#10;FIXED [category], [item_purchased] :COUNT([customer_id])&#10;}' />
      </column>
      <column caption='Rank per category' datatype='integer' name='[Calculation_1077517618593793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Calculation_1077517617221632]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg Rating per Item' datatype='real' name='[Calculation_1077519496257538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [item_purchased]: AVG([review_rating]) }' />
      </column>
      <column caption='Customer Segment' datatype='string' name='[Calculation_1077519714652163]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [previous_purchases] = 0 THEN &quot;New&quot;&#10;ELSEIF [previous_purchases] &lt;= 5 THEN &quot;Returning&quot;&#10;ELSE &quot;Loyal&quot;&#10;END' />
      </column>
      <column caption='Spender type' datatype='string' name='[Calculation_1077520430854149]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [discount_applied]=&apos;Yes&apos; AND [purchase_amount]&gt;=&#10;{AVG([purchase_amount])} THEN &apos;High Spender with discount&apos;&#10;&#10;ELSEIF [discount_applied]=&apos;Yes&apos; AND [purchase_amount]&lt;&#10;{AVG([purchase_amount])} THEN &apos;Spender with discount&apos;&#10;&#10;ELSE &apos;No discount&apos;&#10;END' />
      </column>
      <column caption='Discount rate' datatype='real' default-format='p0.0%' name='[Calculation_1077520461418502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [discount_applied] = &apos;Yes&apos; THEN 1 ELSE 0 END)  / COUNT([customer_id])' />
      </column>
      <column caption='Discount Customer Count' datatype='integer' name='[Calculation_1077520491036680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [discount_applied]=&apos;Yes&apos;&#10;THEN 1&#10;ELSE 0&#10;END)' />
      </column>
      <column caption='Repeat buyers' datatype='string' name='[Calculation_1077520497020937]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [previous_purchases]&gt;5 THEN &apos;Repeat buyer&apos;&#10;ELSE &apos;Not Repeat buyer&apos;&#10;END' />
      </column>
      <column caption='Rem rating' datatype='real' name='[Calculation_4249268874481668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='5-AVG([review_rating])' />
      </column>
      <column caption='Zero' datatype='integer' name='[Calculation_4249268877783046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Box' datatype='string' name='[Calculation_4249337009995776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column aggregation='None' caption='Previous Purchases (bin)' datatype='integer' name='[Previous Purchases (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[previous_purchases]' peg='0' size='5' />
      </column>
